# Backend
DATABASE_URL=postgresql+asyncpg://morpheus:morpheus@localhost:5432/morpheus
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO locally / S3 or R2 in prod)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=morpheus-media

# Auth
JWT_SECRET=change-me

# Gemini API (narrative explanation) — deliberate substitution for the
# Claude API CLAUDE.md's model-stack table specifies; see PROGRESS.md.
# GEMINI_API_KEY_2 is an optional fallback key: gemini_explainer.py retries
# on it if the primary key errors (rate limit, revoked, etc).
GEMINI_API_KEY=placeholder
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.1-flash-lite

# Frontend
VITE_API_BASE_URL=http://localhost:8000
